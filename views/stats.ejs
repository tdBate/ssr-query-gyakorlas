<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>

<body>
    <p>Költések száma: <%= koltesSzam %>
    </p>
    <p>Átlag: <%= atlag %>
    </p>
    <p>Kategóriánként:</p>
    <table>
        <tr>
            <th>Kategória név</th>
            <th>Költések száma</th>
            <th>Összeg</th>
            <th>Átlag</th>
        </tr>
        <% data.forEach(item=> {
            %> <tr>
                <td>
                    <%= item.name %>
                </td>

                <td>
                    <%= item.koltesekSzama %>
                </td>

                <td>
                    <%= item.osszeg %>
                </td>

                <td>
                    <%= item.atlag %>
                </td>


            </tr>

            <% }) %>
    </table>
</body>

</html>